# Supabase (service role: acceso total a la base, solo backend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Clerk (verificacion del token en el backend)
CLERK_SECRET_KEY=sk_test_your-secret-key
CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Groq (analisis con IA + interpretacion de la intencion del escaneo)
GROQ_API_KEY=

# Resend (envio de correos)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Relay WebSocket (pasarela hacia los agentes locales)
RELAY_URL=http://localhost:8787
RELAY_WS_URL=ws://localhost:8787
RELAY_INTERNAL_SECRET=change-me-to-a-random-string

# Servidor
PORT=3001
AGENT_ALLOWED_ORIGIN=http://localhost:8080
AGENT_INTERNAL_SECRET=change-me-to-a-random-string

# URLs publicas (links de los correos y de los instaladores)
SITE_URL=http://localhost:8080
VITE_APP_URL=http://localhost:8080
