# Supabase - se obtienen en el panel del proyecto, Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Clerk - autenticacion (obligatoria: sin esta clave la app no arranca)
# Panel de Clerk -> API Keys -> Publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Backend Express (agent). En local apunta al puerto 3001
VITE_AGENT_URL=http://localhost:3001
